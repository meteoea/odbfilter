/*
 * @SCHEMA@_Sstatic.c - @SCHEMA@ schema static initializer
 * 
 * Registers all SQL view functions for the @SCHEMA@ database schema.
 * ODB uses this to set up the function pointers for
 * each view defined in the SQL files.
 */

#define ODB_GENCODE 0
#include "@SCHEMA@.h"

/* Initialize static function pointers for all @SCHEMA@ views */
PUBLIC void @SCHEMA@_static_init() {
ODB_ANCHOR(@SCHEMA@);
/* Register all SQL views for @SCHEMA@ schema */
@ODB_ANCHOR_VIEWS@
}
